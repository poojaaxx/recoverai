# =============================================================================
# RecoverAI - environment configuration template
# Copy to .env and fill in real values. Never commit the real .env file.
# All values below are placeholders/safe defaults - none are real secrets.
# =============================================================================

# --- DATABASE (PostgreSQL - required in every environment) -------------------
DB_URL=jdbc:postgresql://localhost:5432/recoverai
DB_USERNAME=recoverai
DB_PASSWORD=recoverai

# --- BACKEND SERVER ------------------------------------------------------------
# PORT takes priority when set (Render/Railway/Heroku-style platforms inject
# this and expect the app to bind to it). SERVER_PORT is the explicit
# override for any other host. Leave both unset locally to use 8080.
PORT=
SERVER_PORT=8080
# Which Spring profile to run under: unset/default = PostgreSQL, production-
# shaped config (see application.yml); "prod" = the same, with an explicit,
# no-localhost-fallback CORS requirement and quieter logging (see
# application-prod.yml); "local" = offline H2 fallback, dev-only, never use
# in a real deployment.
SPRING_PROFILES_ACTIVE=

# --- FRONTEND (backend-side: CORS) ---------------------------------------------
# The deployed frontend's origin, e.g. https://recoverai.vercel.app - used to
# restrict CORS so only your real frontend can call the API. Required in the
# "prod" profile (no localhost fallback there). CORS_ALLOWED_ORIGINS is
# accepted as a backward-compatible alias for the same setting.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- FRONTEND (Vite build-time variable) ----------------------------------------
# Exposed to the browser bundle - never put secrets here. This is the only
# VITE_* variable this project uses.
VITE_API_BASE_URL=http://localhost:8080

# --- AI provider --------------------------------------------------------------
# AI_PROVIDER=mock uses a deterministic, rule-based stand-in for local dev,
# automated tests, and the default deployed demo (no API key required, no
# network calls, fails closed the same way a real provider failure would).
# AI_PROVIDER=anthropic uses the real Claude API and requires ANTHROPIC_API_KEY.
# AI_PROVIDER=groq uses Groq's OpenAI-compatible API and requires GROQ_API_KEY.
# Keep this at "mock" unless you are intentionally configuring a real key.
# Both API keys are read server-side only (Spring config, never a VITE_*
# variable) - never logged, never returned by any endpoint, never persisted.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_TIMEOUT_SECONDS=15
ANTHROPIC_MAX_TOKENS=1024
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=15
GROQ_MAX_TOKENS=1024

# --- Razorpay (Test Mode only - never put live/production keys here) ---------
# Two independent opt-ins are both required before any real Razorpay call can
# be made - RAZORPAY_ENABLED=true AND RAZORPAY_MODE=test. Leaving either at
# its default keeps every payment execution simulated (MockPaymentGateway).
RAZORPAY_ENABLED=false
RAZORPAY_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_TIMEOUT_SECONDS=15

# --- Demo dataset (deployment-only, opt-in) -----------------------------------
# When true, seeds the deterministic Phase 2 demo dataset (120 customers, 500
# transactions incl. the 5 named demo transactions) once at application
# startup - safe to leave on for a demo deployment since seeding is
# idempotent (it wipes and regenerates the same dataset every time). Leave
# false/unset for any environment that should not be reseeded on restart.
DEMO_SEED_ENABLED=false
