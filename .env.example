# =============================================================================
# RecoverAI - environment configuration template
# Copy to .env and fill in real values. Never commit the real .env file.
# =============================================================================

# --- Database (PostgreSQL) --------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/recoverai
DB_USERNAME=recoverai
DB_PASSWORD=recoverai

# --- Backend server ----------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite) -----------------------------------------------------------
# Exposed to the browser bundle - never put secrets here.
VITE_API_BASE_URL=http://localhost:8080

# --- AI provider --------------------------------------------------------------
# AI_PROVIDER=mock uses a deterministic, rule-based stand-in for local dev and
# automated tests (no API key required, no network calls).
# AI_PROVIDER=anthropic uses the real Claude API and requires ANTHROPIC_API_KEY.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Razorpay (Test Mode only — never put live keys here) --------------------
# RAZORPAY_MODE=simulation uses the SimulationRecoveryAdapter (no real API calls).
# RAZORPAY_MODE=test uses the RazorpayRecoveryAdapter against Razorpay Test Mode
# and requires the three values below from your Razorpay Test Mode dashboard.
RAZORPAY_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
