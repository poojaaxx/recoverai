# =============================================================================
# RecoverAI - environment configuration template
# Copy to .env and fill in real values. Never commit the real .env file.
# =============================================================================

# --- Database (PostgreSQL) --------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/recoverai
DB_USERNAME=recoverai
DB_PASSWORD=recoverai

# --- Backend server ----------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite) -----------------------------------------------------------
# Exposed to the browser bundle - never put secrets here.
VITE_API_BASE_URL=http://localhost:8080
